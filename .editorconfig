root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.lua]
indent_size = 2

[*.py]
indent_size = 4

[*.{yml,toml,md}]
indent_size = 2

[src/shared/form_scrolling.lua]
indent_size = 4

[src/operations/0[1-7]_*.lua]
indent_size = 4
